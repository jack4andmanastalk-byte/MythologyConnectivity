// 6. カタログ一覧ビュー
// ---------------------------------------------------------------------------
function initCatalogControls() {
  const chipsDiv = document.getElementById("cat-chips");
  const regSel = document.getElementById("cat-region-sel");
  const stpCnt = DATA.nodes.filter(n => isSteppeReg(n.region)).length;
  const ncCnt = DATA.nodes.filter(n => isNorseReg(n.region)).length;
  const iiCnt = DATA.nodes.filter(n => isIIReg(n.region)).length;

  const chipOpts = [
    { key: "ALL", label: `すべて (${DATA.nodes.length})` },
    { key: "ステップ・ウラル（スキタイ・中央亜・フィンウゴル）", label: `🐎 ステップ・ウラル (${stpCnt})` },
    { key: "北欧・ケルト", label: `🛡️ 北欧・ケルト (${ncCnt})` },
    { key: "INDO_IRAN_ALL", label: `🕉️ イラン・インド全4層 (${iiCnt})` },
  ];
  DATA.lanes.forEach(l => {
    if (isSteppeReg(l) || isNorseReg(l)) return;
    const cnt = DATA.nodes.filter(n => n.region === l).length;
    chipOpts.push({ key: l, label: `${shortLaneName(l)} (${cnt})` });
  });

  chipsDiv.innerHTML = chipOpts.map(c =>
    `<span class="chip ${catRegion === c.key ? 'active' : ''}" onclick="window.__setCatRegion('${c.key}')">${escHtml(c.label)}</span>`
  ).join("");
  regSel.innerHTML = chipOpts.map(c => `<option value="${escHtml(c.key)}">${escHtml(c.label)}</option>`).join("");
  regSel.value = catRegion;
}

function renderCatalog() {
  const tbody = document.getElementById("cat-tbody");
  const countEl = document.getElementById("cat-count");
  const q = catSearch.trim().toLowerCase();

  let list = DATA.nodes.filter(n => {
    if (catRegion === "INDO_IRAN_ALL" && !isIIReg(n.region)) return false;
    else if (!["ALL", "INDO_IRAN_ALL"].includes(catRegion) && n.region !== catRegion) return false;
    if (catTag === "sig" && !(n.best_p < 0.05)) return false;
    else if (catTag !== "all" && catTag !== "sig" && n.cat_tag !== catTag) return false;
    if (q) {
      const txt = (n.id + " " + n.name + " " + n.region + " " + n.inherited_motifs + " " + n.residual_motifs).toLowerCase();
      if (!txt.includes(q)) return false;
    }
    return true;
  });

  list.sort((a, b) => {
    if (catSort === "time_asc") return (a.t_eff - b.t_eff) || a.id.localeCompare(b.id);
    if (catSort === "id_asc") return a.id.localeCompare(b.id);
    if (catSort === "out_desc") return (b.out_deg - a.out_deg) || (b.explained_pct - a.explained_pct);
    if (catSort === "exp_desc") return (b.explained_pct - a.explained_pct) || (a.best_p - b.best_p);
    if (catSort === "p_asc") return (a.best_p - b.best_p) || (b.best_z - a.best_z);
    return 0;
  });

  countEl.textContent = `表示中: ${list.length} / ${DATA.nodes.length}件`;
  tbody.innerHTML = list.map(n => {
    const tStr = n.t_eff < 0 ? ("前" + Math.abs(n.t_eff) + "年") : (n.t_eff + " CE");
    const tagLbl = n.cat_tag === "added_steppe" ? '<span class="badge b-stp">ステップ・ウラル</span>' :
                   (n.cat_tag === "layer2_dom" ? '<span class="badge" style="background:#0f766e;color:#ccfbf1;">列島考古律令</span>' :
                   (n.cat_tag === "layer2_ext" ? '<span class="badge" style="background:#5b21b6;color:#ede9fe;">大陸儀礼物質</span>' :
                   (n.cat_tag === "added_v16" ? '<span class="badge" style="background:#9f1239;color:#ffe4e6;">v16拡張</span>' :
                   (n.cat_tag === "added_v15" ? '<span class="badge" style="background:#7f1d1d;color:#fecaca;">v15検証</span>' :
                   (n.cat_tag === "added_norse" ? '<span class="badge b-nc">北欧ケルト新規</span>' :
                   (n.cat_tag.startsWith("added_") ? '<span class="badge b-other">v9-v12増補</span>' :
                   (n.cat_tag === "kojiki" ? '<span class="badge" style="background:#831843;color:#fbcfe8;">古事記</span>' : '<span style="color:#64748b;font-size:10px;">既存</span>')))))));
    const pHtml = n.best_p < 0.05 ? `<b style="color:#fbbf24;">${n.best_p}</b>` : `${n.best_p}`;
    const inh = n.inherited_motifs ? `<span style="color:#93c5fd;">継: ${escHtml(n.inherited_motifs)}</span>` : "";
    const res = n.residual_motifs ? `<span style="color:#6ee7b7;">残: ${escHtml(n.residual_motifs)}</span>` : "";
    const motifs = [inh, res].filter(Boolean).join("<br>") || "<span style='color:#64748b;'>—</span>";
    return `<tr onclick="window.__jumpFromList('${n.id}')">
      <td><b>${escHtml(n.id)}</b></td>
      <td><span class="lane-pill" style="background:${n.color};">${escHtml(n.region)}</span></td>
      <td style="white-space:nowrap;">${tStr}</td>
      <td>${escHtml(n.name)}</td>
      <td>${tagLbl}</td>
      <td>${n.explained_pct}%</td>
      <td>${pHtml}</td>
      <td style="white-space:nowrap;">${n.in_deg} / <b>${n.out_deg}</b></td>
      <td style="font-size:10.3px;">${motifs}</td>
    </tr>`;
  }).join("");
}

function switchTab(tab) {
  activeTab = tab;
  const isGraph = (tab === "graph");
  document.getElementById("tab-graph").classList.toggle("active", isGraph);
  document.getElementById("tab-catalog").classList.toggle("active", !isGraph);
  graphView.style.display = isGraph ? "flex" : "none";
  graphControls.style.display = isGraph ? "flex" : "none";
  catalogView.style.display = isGraph ? "none" : "flex";
  if (!isGraph) renderCatalog();
}

window.__selectNode = (id) => {
  const n = nodeById[id];
  if (!n) return;
  if (!visibleSectors.has(n.region)) {
    visibleSectors.add(n.region);
    renderSectorGrid();
  }
  selectedId = id;
  showDetail(n);
  render();
};
window.__focusNode = (id) => {
  const n = nodeById[id];
  if (!n) return;
  if (!visibleSectors.has(n.region)) {
    visibleSectors.add(n.region);
    renderSectorGrid();
  }
  selectedId = id;
  showDetail(n);
  centerOnNode(n, 2.4);
};
window.__setCatRegion = (reg) => { catRegion = reg; initCatalogControls(); renderCatalog(); };
window.__jumpFromList = (id) => {
  switchTab("graph");
  const n = nodeById[id];
  if (n && !visibleSectors.has(n.region)) {
    visibleSectors.add(n.region);
    renderSectorGrid();
  }
  selectedId = id;
  showDetail(n);
  centerOnNode(n, 2.25);
};

document.getElementById("tab-graph").onclick = () => switchTab("graph");
document.getElementById("tab-catalog").onclick = () => switchTab("catalog");

const drawer = document.getElementById("sector-drawer");
const btnSectors = document.getElementById("btn-sectors");
btnSectors.onclick = () => {
  const isOpen = drawer.classList.toggle("open");
  btnSectors.classList.toggle("open", isOpen);
};
document.getElementById("btn-close-drawer").onclick = () => {
  drawer.classList.remove("open");
  btnSectors.classList.remove("open");
};

document.getElementById("btn-zoom-in").onclick = () => zoomAt(1.32, W * 0.5, H * 0.5);
document.getElementById("btn-zoom-out").onclick = () => zoomAt(1 / 1.32, W * 0.5, H * 0.5);
document.getElementById("btn-zoom-reset").onclick = () => { resetZoom(); render(); };

document.getElementById("chk-dyn-zoom").onchange = (ev) => {
  dynamicZoom = ev.target.checked;
  lastLayoutScale = zoomScale;
  render();
};

document.getElementById("chk-map-bg").onchange = (ev) => {
  showMapBg = ev.target.checked;
  render();
};

document.getElementById("chk-trade").onchange = (ev) => {
  showTrade = ev.target.checked;
  render();
};

document.getElementById("trade-era-sel").onchange = (ev) => {
  tradeEra = ev.target.value;
  render();
};

svg.addEventListener("wheel", (ev) => {
  if (ev.preventDefault) ev.preventDefault();
  const pt = clientToSvg(ev.clientX, ev.clientY);
  zoomAt(ev.deltaY < 0 ? 1.16 : (1 / 1.16), pt.x, pt.y);
}, { passive: false });

svg.addEventListener("mousedown", (ev) => {
  if (ev.button !== undefined && ev.button !== 0) return;
  isDragging = true; dragMoved = false;
  dragStartClientX = ev.clientX; dragStartClientY = ev.clientY;
  dragStartPanX = panX; dragStartPanY = panY;
  svg.classList.add("dragging");
});

svg.addEventListener("mousemove", (ev) => {
  if (!isDragging) return;
  const dxClient = ev.clientX - dragStartClientX, dyClient = ev.clientY - dragStartClientY;
  if (Math.hypot(dxClient, dyClient) > 4) dragMoved = true;
  const rect = svg.getBoundingClientRect();
  const scaleFit = (rect && rect.width > 0 && rect.height > 0) ? Math.min(rect.width / W, rect.height / H) : 1.0;
  panX = dragStartPanX + dxClient / scaleFit;
  panY = dragStartPanY + dyClient / scaleFit;
  applyViewportTransform();
});

svg.addEventListener("mouseup", () => { isDragging = false; svg.classList.remove("dragging"); setTimeout(() => { dragMoved = false; }, 10); });
svg.addEventListener("mouseleave", () => { isDragging = false; svg.classList.remove("dragging"); });

document.getElementById("btn-swim").onclick = () => { mode = "swim"; document.getElementById("btn-swim").classList.add("active"); document.getElementById("btn-geo").classList.remove("active"); resetZoom(); render(); };
document.getElementById("btn-geo").onclick = () => { mode = "geo"; document.getElementById("btn-geo").classList.add("active"); document.getElementById("btn-swim").classList.remove("active"); resetZoom(); render(); };

function setFocus(newMode) {
  focusMode = (focusMode === newMode) ? "none" : newMode;
  document.getElementById("btn-steppe").classList.toggle("active", focusMode === "steppe");
  document.getElementById("btn-norse").classList.toggle("active", focusMode === "norse");
  document.getElementById("btn-pie").classList.toggle("active", focusMode === "pie");
  const bl2 = document.getElementById("btn-v17layer2"); if (bl2) bl2.classList.toggle("active", focusMode === "l2");
  render();
}
document.getElementById("btn-steppe").onclick = () => setFocus("steppe");
document.getElementById("btn-norse").onclick = () => setFocus("norse");
document.getElementById("btn-pie").onclick = () => setFocus("pie");
const _bl2 = document.getElementById("btn-v17layer2"); if (_bl2) _bl2.onclick = () => setFocus("l2");

document.getElementById("sel-edge").onchange = (ev) => { edgeFilter = ev.target.value; if (selectedId && nodeById[selectedId]) showDetail(nodeById[selectedId]); render(); };
document.getElementById("txt-search").oninput = (ev) => { searchQuery = ev.target.value; render(); };
document.getElementById("btn-reset").onclick = () => {
  selectedId = null; searchQuery = ""; focusMode = "none";
  visibleSectors = new Set(DATA.lanes);
  hiddenPathMode = "bridge";
  dynamicZoom = true;
  showMapBg = true;
  showTrade = true;
  tradeEra = "all";
  document.getElementById("chk-dyn-zoom").checked = true;
  document.getElementById("chk-map-bg").checked = true;
  document.getElementById("chk-trade").checked = true;
  document.getElementById("trade-era-sel").value = "all";
  document.getElementById("txt-search").value = "";
  document.getElementById("btn-steppe").classList.remove("active");
  document.getElementById("btn-norse").classList.remove("active");
  document.getElementById("btn-pie").classList.remove("active");
  const _bl2r = document.getElementById("btn-v17layer2"); if (_bl2r) _bl2r.classList.remove("active");
  ["bridge","ghost","strict"].forEach(k => document.getElementById("hm-opt-"+k).classList.toggle("selected", k==="bridge"));
  detailPanel.innerHTML = "";
  renderSectorGrid();
  resetZoom();
  render();
};

document.getElementById("cat-region-sel").onchange = (ev) => { catRegion = ev.target.value; initCatalogControls(); renderCatalog(); };
document.getElementById("cat-tag-sel").onchange = (ev) => { catTag = ev.target.value; renderCatalog(); };
document.getElementById("cat-sort-sel").onchange = (ev) => { catSort = ev.target.value; renderCatalog(); };
document.getElementById("cat-search").oninput = (ev) => { catSearch = ev.target.value; renderCatalog(); };

// テスト・外部確認用フック
window.__v14Debug = {
  getState: () => ({ zoomScale, dynamicZoom, hiddenPathMode, visibleCount: visibleSectors.size }),
  inspectLayout: () => {
    const t = computeSectorVisibilityAndBridges();
    const l = computeDynamicLayout(t);
    return { topo: { vis: t.visNodes.size, ghost: t.ghostNodes.size, bridges: t.bridges.length }, layout: { lanes: l.laneLayout.length, draw: l.drawNodes.length, invScale: l.invScale, expand: l.expand, coords: l.coords } };
  },
  inspectBridges: () => computeSectorVisibilityAndBridges().bridges,
};

initCatalogControls();

(function initTradeEraSelect() {
  const sel = document.getElementById("trade-era-sel");
  if (!sel || !DATA.trade_routes) return;
  const optAll = document.createElement("option");
  optAll.value = "all"; optAll.textContent = "🐫 交易路: 全時代";
  sel.appendChild(optAll);
  (DATA.trade_routes.eras || []).forEach(e => {
    const o = document.createElement("option");
    o.value = e.id; o.textContent = "🐫 " + e.name;
    sel.appendChild(o);
  });
})();
renderSectorGrid();
render();
</script>
</body>
</html>
