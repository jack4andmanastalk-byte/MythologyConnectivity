    outs.sort((a, b) => b[0].z - a[0].z).forEach(([e, layer]) => { html += edgeRow(e, "out", layer); });
  }
  if (!ins.length && !outs.length) {
    html += `<div style="color:var(--muted)">再構築エッジでは孤立（第 2 層接続のみの可能性）。純 L2 接続辺はリポジトリ未追跡のため本 HTML には現れない。</div>`;
  }
  html += `</div>`;

  host.innerHTML = html;
  host.querySelectorAll("[data-goto]").forEach((el) => {
    el.addEventListener("click", () => selectNode(el.getAttribute("data-goto")));
