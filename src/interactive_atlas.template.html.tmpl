/* ---------------- L2 行列 ---------------- */
function renderMatrix() {
  const vocab = [];
  for (let i = 1; i <= 15; i++) vocab.push("R" + String(i).padStart(2, "0"));
  const rows = NODES.filter((n) => n.l2.length);
  let html = `<table class="matrix"><thead><tr><th class="corner">ノード</th>`;
  vocab.forEach((v) => { html += `<th>${v}</th>`; });
  html += `</tr></thead><tbody>`;
  rows.forEach((n) => {
    html += `<tr><th class="rowh" title="${esc(n.name)}">${esc(n.id)} ${esc(n.name)}</th>`;
    vocab.forEach((dim) => {
      const marks = [];
      let maxLv = -1;
      n.l2.forEach((e) => {
        if (e.levels[dim] !== undefined) {
          marks.push(`${e.pass[0].toUpperCase()}${e.levels[dim]}`);
          maxLv = Math.max(maxLv, e.levels[dim]);
        }
      });
      const colors = ["#22304a", "#3c5a76", "#4f8f6f", "#8fc46a", "#d9e86a"];
      const bg = maxLv < 0 ? "#16202f" : colors[maxLv + 1];
      const tip = marks.join(" ");
      html += `<td class="cell" style="background:${bg};color:${maxLv >= 2 ? "#12202f" : "var(--text)"}" data-id="${esc(n.id)}" title="${esc(tip)}">${esc(tip)}</td>`;
    });
    html += `</tr>`;
  });
  html += `</tbody></table>`;
  $("#matrixHost").innerHTML = html;
  $$("#matrixHost td.cell").forEach((td) => {
    td.addEventListener("click", () => selectNode(td.getAttribute("data-id")));
    td.addEventListener("mousemove", (ev) => {
      const n = NODE_BY_ID[td.getAttribute("data-id")];
      const dim = td.cellIndex;
      const dimName = vocab[dim - 1];
      const evid = [];
      n.l2.forEach((e) => {
        if (e.levels[dimName] !== undefined) {
          evid.push(`パス${e.pass} 水準${e.levels[dimName]}（${LEVEL_LABEL[String(e.levels[dimName])]}）: ${e.evidence[dimName] || "（証拠欄なし）"}`);
        }
      });
      tooltip.innerHTML = `<div class="t-title">${esc(n.id)} / ${esc(dimName)}</div>${evid.map(esc).join("<br>")}`;
      tooltip.style.display = "block";
      tooltip.style.left = (ev.clientX + 14) + "px";
      tooltip.style.top = (ev.clientY + 14) + "px";
    });
    td.addEventListener("mouseleave", hideTooltip);
  });
}

/* ---------------- 台帳テーブル ---------------- */
const LEDGER_COLS = [
  ["id", "ID", "str"], ["name", "名称", "str"], ["region", "地域", "str"],
  ["kind", "種", "str"], ["t_eff", "t_eff", "num"],
  ["provenance", "表示出所", "str"],
  ["exp_display", "表示被説明率", "num"], ["exp_replay", "L1再生", "num"],
  ["gap_l1", "乖離", "num"],
  ["v16_expl", "v16被説明", "num"], ["v16_in", "v16 in", "num"], ["v16_out", "v16 out", "num"],
  ["p_in", "主解析 in", "num"], ["p_out", "主解析 out", "num"],
  ["r_in", "参考 in", "num"], ["r_out", "参考 out", "num"]
];
let ledgerSort = { key: "id", dir: 1 };
function ledgerValue(n, key) {
  switch (key) {
    case "gap_l1": return n.gap ? n.gap.gap_l1 : null;
    case "v16_expl": return n.v16 ? n.v16.explained_frac : null;
    case "v16_in": return n.v16 ? n.v16.in_deg : null;
    case "v16_out": return n.v16 ? n.v16.out_deg : null;
    case "p_in": return degIn(n.id, "primary");
    case "p_out": return degOut(n.id, "primary");
    case "r_in": return degIn(n.id, "reference");
    case "r_out": return degOut(n.id, "reference");
    default: return n[key];
  }
}
const degCache = { primary: {}, reference: {} };
["primary", "reference"].forEach((layer) => {
  DATA.edges[layer].forEach((e) => {
    degCache[layer][e.t] = (degCache[layer][e.t] || 0) + 1;
    degCache[layer][e.s] = degCache[layer][e.s] || 0;
  });
});
function degIn(id, layer) { return degCache[layer][id] || 0; }
function degOut(id, layer) {
  let c = 0;
  DATA.edges[layer].forEach((e) => { if (e.s === id) c++; });
  return c;
}
function renderLedger() {
  const rows = NODES.slice().sort((a, b) => {
    const va = ledgerValue(a, ledgerSort.key), vb = ledgerValue(b, ledgerSort.key);
    if (va === null || va === undefined) return 1;
    if (vb === null || vb === undefined) return -1;
    if (typeof va === "number" && typeof vb === "number") return (va - vb) * ledgerSort.dir;
    return String(va).localeCompare(String(vb), "ja") * ledgerSort.dir;
  });
  let html = `<table class="data"><thead><tr>`;
  LEDGER_COLS.forEach(([key, label]) => {
    html += `<th data-key="${key}">${esc(label)}${ledgerSort.key === key ? (ledgerSort.dir > 0 ? " ▲" : " ▼") : ""}</th>`;
  });
  html += `</tr></thead><tbody>`;
  rows.forEach((n) => {
    html += `<tr data-id="${esc(n.id)}" class="${n.id === state.sel ? "sel" : ""}">`;
    LEDGER_COLS.forEach(([key, , type]) => {
      const v = ledgerValue(n, key);
      const shown = v === null || v === undefined ? "—" :
        (type === "num" ? (Number.isInteger(v) ? String(v) : Number(v).toFixed(4)) : String(v));
      html += `<td class="${type === "num" ? "num" : ""}">${esc(shown)}</td>`;
    });
    html += `</tr>`;
  });
  html += `</tbody></table>`;
  $("#ledgerHost").innerHTML = html;
  $$("#ledgerHost th").forEach((th) => {
    th.addEventListener("click", () => {
      const key = th.getAttribute("data-key");
      if (ledgerSort.key === key) ledgerSort.dir *= -1;
      else ledgerSort = { key, dir: 1 };
      renderLedger();
    });
  });
  $$("#ledgerHost tbody tr").forEach((tr) => {
    tr.addEventListener("click", () => selectNode(tr.getAttribute("data-id")));
  });
}

/* ---------------- ヘッダー統計・注記 ---------------- */
function renderChips() {
  const m = DATA.meta.counts;
  const lp = DATA.meta.layers.primary, lr = DATA.meta.layers.reference;
  $("#statChips").innerHTML = `
    <span class="chip">ノード <b>${m.nodes}</b></span>
    <span class="chip">地域 <b>${m.regions}</b></span>
    <span class="chip">L1主解析 辺 <b>${lp.edges}</b></span>
    <span class="chip">L1参考 辺 <b>${lr.edges}</b></span>
    <span class="chip warn">乖離台帳 <b>${m.gap_nodes}</b> 話</span>
    <span class="chip">L2評定 <b>${m.l2_annotation_records}</b> 件</span>
    <span class="chip">L1再評定 <b>${m.l1_audit_records}</b> 件</span>`;
}

function renderNotes() {
  const m = DATA.meta;
  const c = m.counts;
  const pureL2Missing = (m.expected_embedded.edges || 0) - c.frozen_v16_in_deg_sum;
  const srcRows = m.sources.map((s) => `<li><code>${esc(s.path)}</code> — ${esc(s.role)}</li>`).join("");
  $("#notesBody").innerHTML = `
    <h3>この HTML の目的</h3>
    <div>リポジトリの最新の凍結データから、古事記神話とユーラシア神話の対応グラフネットワーク
    （ノード・エッジ・層・出所・乖離）を人間が確認するための自己完結ビューです。
    エッジは v18 決定論的剥離エンジン（<code>src/engine.py</code>）で凍結 75 次元行列から再構築しています。</div>
    <h3>データ出所（すべて Git 追跡済み）</h3>
    <ul>${srcRows}</ul>
    <h3>再構築したエッジ</h3>
    <ul>
      <li>L1主解析（<code>engine.primary</code> 校正済み類似度 z）: <b>${m.layers.primary.edges}</b> 本、
        重み範囲 ${fmtNum(m.layers.primary.weight_min, 2)}〜${fmtNum(m.layers.primary.weight_max, 2)}、
        有向被説明率はノードごとに確認可能。</li>
      <li>L1参考（<code>engine.reference_v17_compatible</code> コサイン）: <b>${m.layers.reference.edges}</b> 本、
        凍結 v16 の in_deg 合計 ${c.frozen_v16_in_deg_sum} 本と比較すると
        ${m.layers.reference.in_deg_mismatch_vs_v16} ノードで入次数が一致しません。
        v17 の手書き変換ペア（TRANS_PAIRS）はリポジトリに追跡されていないため、参考再構築は v16 本来の辺集合と同一ではありません。</li>
    </ul>
    <h3>既知の制約（確認時の注意）</h3>
    <ul>
      <li>v17 埋め込みグラフ（期待値 ${m.expected_embedded.nodes} ノード / ${m.expected_embedded.edges} エッジ）のうち、
        純 L2 接続辺（${pureL2Missing} 本相当 = ${m.expected_embedded.edges} − v16凍結 ${c.frozen_v16_in_deg_sum}）は
        リポジトリに追跡されていないため本 HTML には現れません。アンカーノード（LP01-LP16）の第 2 層接続も同様です。</li>
      <li>ADR 0003 に従い、凍結 HTML の表示値は改変せず台帳表示します。表示被説明率と表示 L1 辺からの再計算が
        閾値 ${m.display_policy.gap_threshold} を超えて異なる ${c.gap_nodes} 話（期待 ${c.gap_expected}）は赤いリングと「乖離」列で識別できます。</li>
      <li>第 2 層 R01-R15 の語彙ラベルは v17 パッケージ側の定義であり、リポジトリには次元 ID と水準のみ追跡されています
        （${esc(m.display_policy.note || "")}）。</li>
    </ul>
    <h3>推奨する確認手順</h3>
    <ul>
      <li>時系列レーンで 19 地域の年代配置とエッジの流れを概観 → 地図で地理配置を確認。</li>
      <li>ノードをクリックし、表示出所・凍結 v16 統計・モチーフ・L2 評定（証拠つき）・接続エッジを個別確認。</li>
      <li>台帳タブで 297 件を列ソートし、乖離・次数・被説明率の全件を機械的に突き合わせる。</li>
      <li>L2行列タブで古事記 37 話・アンカー 16 件の評定水準と証拠をマトリクスで確認する。</li>
    </ul>
    <h3>再生成</h3>
    <div><code>make interactive</code> または <code>python3 src/build_interactive_html.py</code>（要 numpy / pandas）。
    生成物 <code>docs/interactive/graph_network_atlas.html</code> は決定論的で、同入力なら常に同一です。</div>`;
}

/* ---------------- タブ・入力の結線 ---------------- */
function setTab(tab) {
  state.tab = tab;
  $$("#tabs .tab").forEach((b) => b.classList.toggle("active", b.getAttribute("data-tab") === tab));
  const stageTabs = ["map", "timeline", "force"];
  $("#stageWrap").classList.toggle("hidden", !stageTabs.includes(tab));
  $("#viewMatrix").classList.toggle("active", tab === "matrix");
  $("#viewLedger").classList.toggle("active", tab === "ledger");
  stopForce();
  if (tab === "force") startForce();
  else render();
  if (tab === "matrix") renderMatrix();
  if (tab === "ledger") renderLedger();
}
$$("#tabs .tab").forEach((b) => {
  b.addEventListener("click", () => setTab(b.getAttribute("data-tab")));
});

$("#layerPrimary").addEventListener("change", (e) => {
  state.layers.primary = e.target.checked; render();
});
$("#layerReference").addEventListener("change", (e) => {
  state.layers.reference = e.target.checked; render();
});
$("#minZ").addEventListener("input", (e) => {
  state.minZ = Number(e.target.value) / 10;
  $("#minZLabel").textContent = "z≥" + state.minZ.toFixed(1);
  render();
});
$("#minCos").addEventListener("input", (e) => {
  state.minCos = Number(e.target.value) / 100;
  $("#minCosLabel").textContent = "cos≥" + state.minCos.toFixed(2);
  render();
});
$$(".stepChk").forEach((chk) => {
  chk.addEventListener("change", () => {
    state.steps = new Set($$(".stepChk").filter((c) => c.checked).map((c) => c.value));
    render();
  });
});
$("#kindEurasia").addEventListener("change", (e) => toggleKind("eurasia", e.target.checked));
$("#kindKojiki").addEventListener("change", (e) => toggleKind("kojiki", e.target.checked));
$("#kindAnchor").addEventListener("change", (e) => toggleKind("anchor", e.target.checked));
function toggleKind(kind, on) {
  if (on) state.kinds.add(kind); else state.kinds.delete(kind);
  render();
}
$("#gapOnly").addEventListener("change", (e) => {
  state.gapOnly = e.target.checked; render();
});
$("#searchBox").addEventListener("input", (e) => {
  state.search = e.target.value.trim();
  render();
});
$("#searchBox").addEventListener("keydown", (e) => {
  if (e.key === "Enter" && state.search) {
    const hit = NODES.find(nodeVisible);
    if (hit) selectNode(hit.id);
  }
});
$("#btnReset").addEventListener("click", () => {
  state.view = { tx: 0, ty: 0, k: 1 };
  applyView();
  state.search = "";
  $("#searchBox").value = "";
  state.gapOnly = false;
  $("#gapOnly").checked = false;
  state.minZ = 0; state.minCos = 0;
  $("#minZ").value = 0; $("#minCos").value = 0;
  $("#minZLabel").textContent = "z≥0.0";
  $("#minCosLabel").textContent = "cos≥0.00";
  render();
});

/* 地域フィルタ */
function renderRegionMenu() {
  const host = $("#regionMenu");
  let html = `<div class="row" style="gap:8px;">
    <button id="regAll">全選択</button><button id="regNone">全解除</button></div>`;
  REGIONS.forEach((reg) => {
    const cnt = NODES.filter((n) => n.region === reg).length;
    html += `<div class="row">
      <span class="sw" style="background:${REGION_COLOR[reg]}"></span>
      <label><input type="checkbox" class="regChk" value="${esc(reg)}" checked> ${esc(reg)}（${cnt}）</label>
    </div>`;
  });
  host.innerHTML = html;
  $("#regAll").addEventListener("click", () => {
    state.regions = new Set(REGIONS);
    $$(".regChk").forEach((c) => { c.checked = true; });
    updateRegionSummary(); render();
  });
  $("#regNone").addEventListener("click", () => {
    state.regions = new Set();
    $$(".regChk").forEach((c) => { c.checked = false; });
    updateRegionSummary(); render();
  });
  $$(".regChk").forEach((chk) => {
    chk.addEventListener("change", () => {
      if (chk.checked) state.regions.add(chk.value);
      else state.regions.delete(chk.value);
      updateRegionSummary(); render();
    });
  });
}
function updateRegionSummary() {
  const n = state.regions.size;
  $("#regionSummary").textContent = n === REGIONS.length ? "地域フィルタ" : `地域 ${n}/${REGIONS.length}`;
}

/* 注記オーバーレイ */
$("#btnNotes").addEventListener("click", () => {
  renderNotes();
  $("#overlay").classList.add("open");
});
$("#btnCloseNotes").addEventListener("click", () => $("#overlay").classList.remove("open"));
$("#overlay").addEventListener("click", (ev) => {
  if (ev.target === $("#overlay")) $("#overlay").classList.remove("open");
});

function updateStatus() {
  const shown = NODES.filter(nodeVisible).length;
  const l1 = DATA.edges.primary.filter((e) => edgeVisible(e, "primary")).length;
  const l2 = DATA.edges.reference.filter((e) => edgeVisible(e, "reference")).length;
  $("#statusText").textContent =
    `表示中: ノード ${shown}/${NODES.length} / L1主解析 ${l1} 辺 / L1参考 ${l2} 辺` +
    (state.sel ? ` / 選択: ${state.sel}` : "");
}

/* ---------------- 初期化 ---------------- */
renderChips();
renderRegionMenu();
applyView();
setTab("map");
</script>
</body>
</html>
