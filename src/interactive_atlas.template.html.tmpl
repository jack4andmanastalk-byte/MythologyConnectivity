function motifBadges(str) {
  if (!str) return "<span style='color:#64748b;'>なし</span>";
  return str.split(",").filter(Boolean).map(m => `<span class="motif-tag">${escHtml(m)}: ${escHtml(DATA.motif_desc[m] || m)}</span>`).join("");
}

// ---------------------------------------------------------------------------
// v18 追記: 表示監査（ADR 0003）・第2層評定（証拠つき）・L1 再評定カード
// ---------------------------------------------------------------------------
const V18_LEVEL_LABEL = { "0": "不在", "1": "痕跡・言及のみ", "2": "明確に存在", "3": "中心的・定義的" };
const v18Pct = (v) => (v === null || v === undefined) ? "—" : (v * 100).toFixed(2) + "%";

function v18GapBadge(n) {
  return n.gap ? '<span class="badge" style="background:#7f1d1d;color:#fecaca;border:1px solid #f87171;">⚠ 乖離台帳 (ADR 0003)</span>' : '';
}

function v18AnnotationCard(title, entries) {
  if (!entries || !entries.length) return "";
  const rows = entries.map(e => {
    const lv = Object.keys(e.levels).sort().map(k =>
      `<span class="motif-tag"><b>${escHtml(k)}</b> 水準${e.levels[k]}（${escHtml(V18_LEVEL_LABEL[String(e.levels[k])] || "")}）`
      + `<span style="color:#64748b;"> ${escHtml(DATA.motif_desc[k] || k)}</span></span>`).join("");
    const ev = Object.keys(e.evidence).sort().map(k =>
      `<div style="margin-top:3px;">◆ <b>${escHtml(k)}</b>: ${escHtml(e.evidence[k])}</div>`).join("");
    const note = e.notes ? `<div style="color:#94a3b8;margin-top:2px;">（注）${escHtml(e.notes)}</div>` : "";
    return `<div class="edge-row" style="cursor:default;"><span class="badge b-other">パス ${escHtml(e.pass)}</span>`
      + ` <span style="color:#94a3b8;">${escHtml(e.annotator)} / ${escHtml(e.coded_at)} / ${escHtml(e.file)}</span>`
      + `<div>${lv}</div>${ev}${note}</div>`;
  }).join("");
  return `<div class="card"><h2>${title}</h2>${rows}</div>`;
}

function v18Cards(n) {
  let audit = "";
  const provLbl = { "v16.L1": "v16.L1（第1層表示）", "decomp.total_final": "decomp.total_final（3層合成表示）", "pureL2_dom": "pureL2_dom（第2層支配表示）" }[n.provenance] || escHtml(n.provenance || "—");
  if (n.gap) {
    audit = `<div class="card"><h2>📊 表示監査（ADR 0003）乖離台帳</h2>
      <p>表示被説明率 <b>${n.explained_pct}%</b>（出所: ${provLbl}）／ 表示 L1 辺からの再計算 <b>${v18Pct(n.exp_replay)}</b></p>
      <p style="margin-top:4px;"><span class="badge" style="background:#7f1d1d;color:#fecaca;border:1px solid #f87171;">gap_l1 ${n.gap.gap_l1}</span>
      <span class="motif-tag">v16 L1: ${v18Pct(n.gap.v16_l1_pct)}</span>
      <span class="motif-tag">3層分解 l1_only: ${v18Pct(n.gap.decomp_l1_only_pct)}</span>
      <span class="motif-tag">l2_ext 増分: ${v18Pct(n.gap.decomp_l2_ext_gain_pct)}</span>
      <span class="motif-tag">l2_dom 増分: ${v18Pct(n.gap.decomp_l2_dom_gain_pct)}</span>
      <span class="motif-tag">total_final: ${v18Pct(n.gap.decomp_total_final_pct)}</span></p>
      <p style="margin-top:4px;color:#94a3b8;">${escHtml(n.gap.display_note)}</p></div>`;
  } else {
    audit = `<div class="card"><h2>📊 表示監査（ADR 0003）</h2>
      <p>表示被説明率 <b>${n.explained_pct}%</b>（出所: ${provLbl}）／ 表示 L1 辺からの再計算 <b>${v18Pct(n.exp_replay)}</b> <span class="badge b-shr">乖離なし</span></p></div>`;
  }
  return audit
    + v18AnnotationCard("🗳 第2層 評定 L2_R01-R15（証拠つき・v18）", n.l2)
    + v18AnnotationCard("🔬 L1 信頼性 再評定（独立監査・v18）", n.l1audit);
}

function getCatBadge(cat) {
  if (cat === "added_steppe") return '<span class="badge b-stp">ステップ・ウラル追加</span>';
  if (cat === "layer2_dom") return '<span class="badge" style="background:#0f766e;color:#ccfbf1;border:1px solid #5eead4;">★ 第2層:列島考古律令</span>';
  if (cat === "layer2_ext") return '<span class="badge" style="background:#5b21b6;color:#ede9fe;border:1px solid #c4b5fd;">★ 第2層:大陸儀礼物質</span>';
  if (cat === "added_v16") return '<span class="badge" style="background:#9f1239;color:#ffe4e6;">v16 叙事詩仏典</span>';
  if (cat === "added_v15") return '<span class="badge" style="background:#7f1d1d;color:#fecaca;">v15 東亜検証</span>';
  if (cat === "added_norse") return '<span class="badge b-nc">v13 北欧ケルト新規</span>';
  if (cat.startsWith("added_")) return '<span class="badge b-other">v9-v12 増補</span>';
  return '';
}

function showDetail(n, topoInfoOpt) {
  if (!n) { detailPanel.innerHTML = ""; return; }
  const topoInfo = topoInfoOpt || computeSectorVisibilityAndBridges();
  const inc = DATA.edges.filter(e => e.target === n.id);
  const out = DATA.edges.filter(e => e.source === n.id);
  const tStr = n.t_eff < 0 ? ("紀元前" + Math.abs(n.t_eff) + "年") : ("西暦" + n.t_eff + "年");
  const sigBadge = n.best_p < 0.05 ? '<span class="badge b-sig">有意接続 p&lt;0.05</span>' : '';

  const relBridgesIn = topoInfo.bridges.filter(b => b.target === n.id);
  const relBridgesOut = topoInfo.bridges.filter(b => b.source === n.id);
  let brgHtml = "";
  if (relBridgesIn.length || relBridgesOut.length) {
    const rowsIn = relBridgesIn.map(b => `<div class="edge-row" onclick="window.__selectNode('${b.source}')"><span class="badge b-brg">🌉間接由来</span> <b>${escHtml(b.source)}</b> (${escHtml(nodeById[b.source].short_name)}) ⇢ 当ノード<br><span style="color:#fde68a;">経由 (${b.paths.length}ルート): ${escHtml(b.paths[0].via.map(v=>v+'('+shortLaneName(nodeById[v].region)+')').join(' → '))}</span></div>`).join("");
    const rowsOut = relBridgesOut.map(b => `<div class="edge-row" onclick="window.__selectNode('${b.target}')"><span class="badge b-brg">🌉間接派生</span> 当ノード ⇢ <b>${escHtml(b.target)}</b> (${escHtml(nodeById[b.target].short_name)})<br><span style="color:#fde68a;">経由 (${b.paths.length}ルート): ${escHtml(b.paths[0].via.map(v=>v+'('+shortLaneName(nodeById[v].region)+')').join(' → '))}</span></div>`).join("");
    brgHtml = `<div class="card"><h2>🌉 非表示セクター経由 間接ブリッジ (${relBridgesIn.length + relBridgesOut.length}本)</h2>${rowsIn}${rowsOut}</div>`;
  }

  let incHtml = inc.length ? inc.map(e => `
    <div class="edge-row" onclick="window.__selectNode('${e.source}')">
      <span class="badge ${e.type === 'directed_transmission' ? 'b-dir' : 'b-shr'}">${e.type === 'directed_transmission' ? '時差→' : '祖型↔'}</span>
      <b>${escHtml(e.source)}</b> (${escHtml(e.source_region)}) | Δt=${e.dt}年, 重み=${e.weight}, 距離=${e.dist_km}km<br>
      <span style="color:#94a3b8;">共有: ${escHtml(e.shared)} | 変換: ${escHtml(e.transforms)}</span>
    </div>`).join("") : "<p style='color:#64748b;'>上流親エッジなし（初期独立・祖型層）</p>";

  let outHtml = out.length ? out.map(e => `
    <div class="edge-row" onclick="window.__selectNode('${e.target}')">
      <span class="badge ${e.type === 'directed_transmission' ? 'b-dir' : 'b-shr'}">${e.type === 'directed_transmission' ? '時差→' : '祖型↔'}</span>
      → <b>${escHtml(e.target)}</b> (${escHtml(e.target_region)}) | Δt=${e.dt}年, 重み=${e.weight}, 距離=${e.dist_km}km
    </div>`).join("") : "<p style='color:#64748b;'>下流派生エッジなし（終端・受容層）</p>";

  detailPanel.innerHTML = `
    <div class="card">
      <h2>${escHtml(n.id)} | ${escHtml(n.name)}</h2>
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:4px;">
        <div>${getCatBadge(n.cat_tag)}${sigBadge}${v18GapBadge(n)}</div>
        <button onclick="window.__focusNode('${n.id}')" style="font-size:10.5px;padding:2px 7px;">🔍 動的拡大(240%)</button>
      </div>
      <p style="margin-top:5px;"><b>層位/時期:</b> ${escHtml(n.region)} (${tStr})</p>
      <p><b>被説明率:</b> ${n.explained_pct}% (p=${n.best_p}, Z=${n.best_z})</p>
    </div>
    ${v18Cards(n)}
    ${brgHtml}
    <div class="card"><h2>先行由来モチーフ（剥離・継承層）</h2><div>${motifBadges(n.inherited_motifs)}</div></div>
    <div class="card"><h2>固有残余モチーフ（時代・地域独自層）</h2><div>${motifBadges(n.residual_motifs)}</div></div>
    <div class="card"><h2>上流親エッジ (${inc.length}本)</h2>${incHtml}</div>
    <div class="card"><h2>下流派生エッジ (${out.length}本)</h2>${outHtml}</div>
  `;
}

function renderSectorGrid() {
  const grid = document.getElementById("sector-grid");
  const btn = document.getElementById("btn-sectors");
  if (btn) btn.textContent = `🎛 セクター選択 (${visibleSectors.size}/${DATA.lanes.length})`;
  if (!grid) return;
  grid.innerHTML = DATA.lanes.map((lane, idx) => {
    const on = visibleSectors.has(lane);
    const cnt = DATA.nodes.filter(n => n.region === lane).length;
    return `<label class="sec-chk ${on ? 'on' : ''}" onclick="window.__toggleSector(${idx}, event)">
      <input type="checkbox" ${on ? 'checked' : ''}>
      <span class="sec-dot" style="background:${DATA.lane_colors[lane]};"></span>
      <span>${escHtml(shortLaneName(lane))}</span>
      <span class="sec-cnt">${cnt}</span>
    </label>`;
  }).join("");
}

window.__toggleSector = (idx, ev) => {
  if (ev && ev.stopPropagation) ev.stopPropagation();
  if (ev && ev.preventDefault) ev.preventDefault();
  const lane = DATA.lanes[idx];
  if (visibleSectors.has(lane)) visibleSectors.delete(lane);
  else visibleSectors.add(lane);
  renderSectorGrid();
  render();
};

window.__setHiddenMode = (m) => {
  hiddenPathMode = m;
  ["bridge", "ghost", "strict"].forEach(k => {
    const el = document.getElementById("hm-opt-" + k);
    if (el) el.classList.toggle("selected", k === m);
  });
  if (selectedId && nodeById[selectedId]) showDetail(nodeById[selectedId]);
  render();
};

window.__applyPreset = (preset) => {
  if (preset === "all") {
    visibleSectors = new Set(DATA.lanes);
  } else if (preset === "none") {
    visibleSectors = new Set();
  } else if (preset === "meso_ii_jp") {
    visibleSectors = new Set(DATA.lanes.filter(l => l.startsWith("メソポタミア") || isIIReg(l) || l === "古事記（日本）"));
  } else if (preset === "ie_steppe_norse") {
    visibleSectors = new Set(DATA.lanes.filter(l => isIIReg(l) || isSteppeReg(l) || isNorseReg(l)));
  } else if (preset === "v17_dual_layer_royalty") {
    visibleSectors = new Set(["メソポタミア（OB～MB）", "メソポタミア（NA以降）", "インド（ヴェーダ・ウパニシャッド）", "インド（仏教・ジャータカ・仏伝）", "ステップ・ウラル（スキタイ・中央亜・フィンウゴル）", "シベリア・アイヌ・北アジア", "中国・華南", "朝鮮・満洲", "列島前史・律令考古", "古事記（日本）"]);
  } else if (preset === "east_asia_jp") {
    visibleSectors = new Set(["シベリア・アイヌ・北アジア", "中国・華南", "東南アジア・台湾", "朝鮮・満洲", "古事記（日本）"]);
  } else if (preset === "ii_steppe") {
    visibleSectors = new Set(DATA.lanes.filter(l => isIIReg(l) || isSteppeReg(l)));
  }
  renderSectorGrid();
  if (selectedId && nodeById[selectedId]) showDetail(nodeById[selectedId]);
  render();
};

