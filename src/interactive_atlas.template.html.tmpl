      <span class="k">in_deg / out_deg</span><span class="v">${fmtNum(n.v16.in_deg, 0)} / ${fmtNum(n.v16.out_deg, 0)}（v16凍結）</span>
      <span class="k">cat_tag</span><span class="v">${esc(n.v16.cat_tag)}${n.v16.is_extra ? "（追加ノード）" : ""}</span>
