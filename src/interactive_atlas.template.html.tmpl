  const outs = DATA.edges.primary.filter((e) => e.s === n.id).map((e) => [e, "primary"])
    .concat(DATA.edges.reference.filter((e) => e.s === n.id).map((e) => [e, "reference"]));
  html += `<div class="dsec"><h3>接続エッジ（主解析＋参考・sim 順）</h3>`;
  if (ins.length) {
