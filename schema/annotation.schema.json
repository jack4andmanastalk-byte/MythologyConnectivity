{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v18 annotation record",
  "type": "object",
  "required": ["schema", "target", "grid", "annotator", "pass", "coded_at", "levels", "evidence"],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "v18.annotation/1"},
    "target": {"type": "string", "pattern": "^(K[1-3]-[0-9]{2}|LP[0-9]{2}|[A-Z])"},
    "grid": {"type": "string", "enum": ["layer2_power_ritual_regalia_15d", "layer1_10d_audit"]},
    "annotator": {"type": "string"},
    "pass": {"type": "string", "enum": ["A", "B", "legacy"]},
    "coded_at": {"type": "string"},
    "levels": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 3}},
    "evidence": {"type": "object", "additionalProperties": {"type": "string"}},
    "confidence": {"type": "object", "additionalProperties": {"type": "string", "enum": ["high", "medium", "low"]}},
    "note": {"type": "string"}
  }
}
