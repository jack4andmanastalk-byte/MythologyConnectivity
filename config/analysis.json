  "doc_checks": {
    "exempt_marker": "doc-number-exempt",
    "note": "パターンは『総数を主張する表現』に限定する。部分集合（評価可能・プロファイル・うち等）は context_allow で除外。",
    "rules": [
      {
        "id": "kojiki-node-count",
        "label": "古事記ノード数",
        "source": "data/frozen/nodes_297.csv:kind==kojiki",
        "value": 37,
        "patterns": [
          "古事記\\s*(\\d+)\\s*話(?!\\s*[のにをへ（(])"
        ],
        "context_allow": [
          "評価可能",
          "プロファイル",
          "with_profile",
          "evaluable",
          "profiled"
        ],
        "note": "部分集合は「古事記 N 話の/に/を/へ/(」の形で書く。総数は「古事記 37 話」と裸で書く。"
      },
      {
        "id": "network-check-count",
        "label": "ネットワーク検査項目数",
        "source": "verify_network.checks",
        "value": 60,
        "patterns": [
          "検査\\s*(\\d+)\\s*項目",
          "(\\d+)\\s*チェック",
          "全\\s*(\\d+)\\s*項目",
          "(\\d+)\\s*checks?\\b"
        ],
        "context_allow": [
          "当時",
          "初版",
          "v17 検証"
        ]
      },
      {
        "id": "registry-branch-count",
        "label": "登録枝数",
        "source": "docs/registry.md",
        "value": null,
        "patterns": [
          "全\\s*(\\d+)\\s*枝"
        ],
        "context_allow": [
          "仮説検定のみ"
        ]
      },
      {
        "id": "graph-node-count",
        "label": "グラフのノード数",
        "source": "derived/v17_html_embedded_data.json",
        "value": 297,
        "patterns": [
          "(\\d+)\\s*ノード\\s*/\\s*\\d+\\s*エッジ",
          "(\\d+)\\s*nodes?\\s*/\\s*\\d+\\s*edges?"
        ],
        "context_allow": []
      }
    ],
    "violation_snippet_chars": 160,
    "exemption_budget": 10,
    "exemption_budget_note": "凍結レポートの当時値の引用（7 行）＋ 2026-11-28 の並列性実験で注入した誤値の引用（3 行）。新規に増やすときは理由をここに書く。"
  },
